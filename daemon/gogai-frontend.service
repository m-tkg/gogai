[Unit]
Description=Gogai Frontend
After=network.target gogai-backend.service

[Service]
Type=simple
User=masaki
WorkingDirectory=/home/masaki/gogai/frontend
ExecStartPre=-npm run build
ExecStart=npm run preview
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
